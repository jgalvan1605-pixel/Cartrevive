datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id                   String       @id @default(uuid())
  name                 String
  email                String       @unique
  password             String?
  shopifySecret        String?
  holdedApiKey         String?
  holdedFunnelId       String?
  holdedStageId        String?
  holdedWonStageId     String?
  telegramBotToken     String?
  telegramChatId       String?
  minThreshold         Float        @default(150.0)
  whatsappTemplate     String?      @default("Hola {nombre}, te contacto de la tienda porque vi tu pedido pendiente por {monto} {moneda} ({articulos}). ¿Te ha surgido alguna duda durante el pago? Te facilito tu enlace directo: {link}")
  plan                 String       @default("PRO")
  isActive             Boolean      @default(true)

  // --- CONTROL DE PRUEBA 15 DÍAS Y STRIPE ---
  trialEndsAt          DateTime?
  subscriptionStatus   String       @default("TRIALING") // TRIALING | ACTIVE | EXPIRED | CANCELED
  stripeCustomerId     String?
  stripeSubscriptionId String?

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  agents               SalesAgent[]
  cartLogs             CartLog[]
}

model SalesAgent {
  id             String    @id @default(uuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  telegramChatId String?
  holdedUserId   String?
  minAmount      Float     @default(0.0)
  maxAmount      Float?
  isActive       Boolean   @default(true)
  lastAssignedAt DateTime?
  createdAt      DateTime  @default(now())

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedCarts  CartLog[]
}

model CartLog {
  id             Int       @id @default(autoincrement())
  tenantId       String
  shopifyCartId  BigInt
  shopifyOrderId BigInt?
  customerName   String
  customerEmail  String?
  customerPhone  String?
  cartAmount     Float
  currency       String    @default("EUR")
  status         String    @default("QUALIFIED") // QUALIFIED, IGNORED, RECOVERED
  holdedDealId   String?
  agentId        String?
  assignedToName String?
  recoveryUrl    String?
  itemsSummary   String?
  recoveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent          SalesAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, shopifyCartId])
}